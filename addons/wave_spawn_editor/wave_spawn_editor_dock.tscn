[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/wave_spawn_editor/wave_spawn_editor_dock.gd" id="1"]

[node name="WaveSpawnEditorDock" type="Control"]
custom_minimum_size = Vector2(320, 240)
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Root" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Root"]
layout_mode = 2
text = "波次配置编辑器"

[node name="InfoLabel" type="Label" parent="Root"]
layout_mode = 2
autowrap_mode = 3
text = "敌人由运行时从商店角色池随机 roll（Tier 上限随 wave_index+1）。此处仅编辑 spawn_count 与 wave_gold_reward。"

[node name="PathRow" type="HBoxContainer" parent="Root"]
layout_mode = 2

[node name="PathEdit" type="LineEdit" parent="Root/PathRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "res://resources/levels/realtime/rt_wave_01.tres"

[node name="LoadButton" type="Button" parent="Root/PathRow"]
layout_mode = 2
text = "加载"

[node name="SaveButton" type="Button" parent="Root/PathRow"]
layout_mode = 2
text = "保存"

[node name="EditRow" type="GridContainer" parent="Root"]
layout_mode = 2
columns = 2

[node name="SpawnCountLabel" type="Label" parent="Root/EditRow"]
layout_mode = 2
text = "敌人数 spawn_count"

[node name="SpawnCountSpin" type="SpinBox" parent="Root/EditRow"]
unique_name_in_owner = true
layout_mode = 2
max_value = 64.0
value = 3.0

[node name="GoldLabel" type="Label" parent="Root/EditRow"]
layout_mode = 2
text = "波次金币 wave_gold_reward"

[node name="GoldSpin" type="SpinBox" parent="Root/EditRow"]
unique_name_in_owner = true
layout_mode = 2
min_value = -1.0
max_value = 999.0
value = -1.0

[node name="StatusLabel" type="Label" parent="Root"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
text = "加载 WaveData 资源后开始编辑"

[connection signal="pressed" from="Root/PathRow/LoadButton" to="." method="_on_load_pressed"]
[connection signal="pressed" from="Root/PathRow/SaveButton" to="." method="_on_save_pressed"]
