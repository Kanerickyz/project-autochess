[ext_resource type="Theme" path="res://resources/ui/ui_shell_theme.tres" id="4_shell_theme"]

[node name="RealtimeBattle" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
